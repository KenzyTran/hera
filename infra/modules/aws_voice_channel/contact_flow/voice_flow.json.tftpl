{
  "Version": "2019-10-30",
  "StartAction": "set-voice",
  "Actions": [
    {
      "Identifier": "set-voice",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": {
        "TextToSpeechVoice": "Joanna",
        "TextToSpeechEngine": "neural"
      },
      "Transitions": {
        "NextAction": "play-greeting",
        "Errors": [],
        "Conditions": []
      }
    },
    {
      "Identifier": "play-greeting",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "${greeting_text}"
      },
      "Transitions": {
        "NextAction": "get-input",
        "Errors": [],
        "Conditions": []
      }
    },
    {
      "Identifier": "get-input",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": " ",
        "LexV2Bot": {
          "AliasArn": "${lex_bot_alias_arn}"
        },
        "LexSessionAttributes": {}
      },
      "Transitions": {
        "NextAction": "play-answer",
        "Errors": [
          { "NextAction": "play-error", "ErrorType": "InputTimeLimitExceeded" },
          { "NextAction": "play-error", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "play-error", "ErrorType": "NoMatchingError" }
        ],
        "Conditions": []
      }
    },
    {
      "Identifier": "play-answer",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "$.Lex.SessionAttributes.answer"
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [],
        "Conditions": []
      }
    },
    {
      "Identifier": "play-error",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "${error_prompt}"
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [],
        "Conditions": []
      }
    },
    {
      "Identifier": "disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
