# Terraform module lock files generated by standalone `terraform init` for
# per-module validate. Only the root env (infra/envs/prod/.terraform.lock.hcl)
# is committed for reproducibility.
infra/modules/*/.terraform.lock.hcl

# Phase 3 widget deploy artifact (bin/build-widget.sh writes here; never source).
dist/

# Local secrets (never commit). Langfuse keys, OpenAI keys, scratch env files.
.env
.env.*

# Claude Code project instructions (internal dev tooling, not part of public
# workshop repo). Stays local so Claude Code reads it; never shipped to GitHub.
CLAUDE.md

# Phase 3 CDK project artifacts (Plan 03-04). Lockfile (uv.lock) IS committed.
infra/cdk/.venv/
infra/cdk/cdk.out/
infra/cdk/__pycache__/
infra/cdk/**/__pycache__/

# TF -> CDK bridge file (generated by `terraform output -json`; live deploy artifact).
infra/envs/prod/terraform-outputs.json

# Phase 3 widget_presigner Lambda zip build dir (Plan 03-04 Task 5a).
# archive_file writes handler.zip here; rebuild on every apply from src/.
infra/modules/widget_presigner/build/

# Phase 6.1 aws_voice_channel Lookup Lambda zip build dir (Plan 06.1-02 Task 3).
# archive_file writes handler.zip here; rebuild on every apply from lambda/.
infra/modules/aws_voice_channel/build/

