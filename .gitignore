# Terraform module lock files generated by standalone `terraform init` for
# per-module validate. Only the root env (infra/envs/prod/.terraform.lock.hcl)
# is committed for reproducibility.
infra/modules/*/.terraform.lock.hcl

# Phase 3 widget deploy artifact (bin/build-widget.sh writes here; never source).
dist/

# Phase 3 CDK project artifacts (Plan 03-04). Lockfile (uv.lock) IS committed.
infra/cdk/.venv/
infra/cdk/cdk.out/
infra/cdk/__pycache__/
infra/cdk/**/__pycache__/

# TF -> CDK bridge file (generated by `terraform output -json`; live deploy artifact).
infra/envs/prod/terraform-outputs.json
