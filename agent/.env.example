# Hera Pipecat agent — Phase 2 local dev environment.
# Copy to .env (which is gitignored) and fill in values from your AWS credentials.

# Required: AWS credentials (used by both AWSNovaSonicLLMService and boto3 KB client).
# AWSNovaSonicLLMService uses StaticCredentialsResolver and reads these explicitly
# from os.environ — boto3 default chain (~/.aws) is NOT enough on its own.
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE
# Optional: only needed if your credentials are short-lived (SSO, AssumeRole).
# AWS_SESSION_TOKEN=

# Required: live Phase 1 KB ID. Resolve with:
#   terraform -chdir=infra/envs/prod output -raw kb_id
HERA_KB_ID=BKXE19AH89

# Defaults (override only if you know why):
AWS_REGION=ap-northeast-1
HERA_KB_SCORE_THRESHOLD=0.4
HERA_VOICE=matthew
